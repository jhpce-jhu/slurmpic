# No longer used. If needed, consider using "my-cluster-is".
#whereami=`/usr/bin/hostname`

DEFAULT_PARTITION='shared'

# Which partitions to display when user says -g | --gpu
GPU_PARTITIONS='caracol,gee,gpu,neuron,bstgpu,bstgpu2,bstgpu3'
GPUSTATS=0

SINFOOPTS='Nodelist:13,StateComplete:100,Partition:10,CPUsState:.16,CPUsLoad:.10,Memory:.8,AllocMem:.10,FreeMEM:.10'

usage() {
    cat <<EOF
$(basename "$0"): Used to display a summary of SLURM node usage & status.
               Terminal windows 90+ char wide best for viewing slurmpic output.
               Summary stats at end are for specified partition(s), and
               exclude values for nodes in DOWN, DRAIN & RESERVED states.
               Per-node CPU/RAM used values are for all jobs from all partitions.

$(basename "$0") [ -p|--partition <name>[,<name>... ] [ -a|--all ] [ -g|--gpu ]
$(basename "$0") [ -h|--help ]
$(basename "$0") [ -k|--key ]

 -p | --partition Show information for a specific PARTITION or a comma-separated
                  list. Otherwise defaults to "$DEFAULT_PARTITION" or what is
		  specified in ~/.slurm/defaults
 -a | --all       Show information for all partitions.
                  Note: slurmpic uses sinfo, which will not display node info
                  for partitions which require UNIX group membership (unless you
                  are root or a member of those groups). For non-root users,
                  "slurmpic -a" will not display those nodes (or count their resources).
 -g | --gpu       When used alone, displays information for all GPU partitions.
                  Otherwise it adds GPU-specific columns & statistics.
 -k | --key       Guide to color meaning for state & resources.
 -h | --help      Display this information.
EOF
}

# What is the cluster or user's default partition name?
# (If user specifies one it overrides the choice made here.)
# We presume to be running on main cluster. JADE does not have ANY usable
# common partitions. Instead each user has a ~/.slurm/defaults file. (JRT
# created /root/.slurm/defaults containing s-shared.)
default_partition() {

PARTITION="-p ${DEFAULT_PARTITION}"

# Note that both -p & --partition begin with same string
echo $@ | grep "\-p" > /dev/null 2>&1
POPT=$?
if [ -f ~/.slurm/defaults -a $POPT != 0 ]
then
    LOCALDEFAULT=`grep "^partition" ~/.slurm/defaults | cut -d= -f2`
    if [ ! -z ${LOCALDEFAULT} ]
    then
        scontrol show partition $LOCALDEFAULT > /dev/null 2>&1
        if [ $? == 0 ]
        then
            #echo "Using Default Partition from ~/.slurm/defaults: $LOCALDEFAULT"
            PARTITION="-p $LOCALDEFAULT"
        else
            echo "Found invalid partition name $LOCALDEFAULT in ~/.slurm/defaults"
            echo "so we will exit."
            exit 1
        fi
    fi
fi
}

default_partition

# Process flags
while [[ $# -gt 0 ]]
do
      case $1 in
    -p|--partition)
      if [ -z "$2" ]
      then
        echo "Error: The -p option must be followed by partition name"
        exit 1
      fi
      PARTITION="-p $2"
      shift # past argument
      shift # past value
      ;;
    -a|--all)
      PARTITION=""
      shift # past value
      ;;
    -g|--gpu)
      PARTITION="-p $GPU_PARTITIONS"
      GPUSTATS=1
      SINFOOPTS=${SINFOOPTS}",Gres:.70,GresUsed:.70"
      shift # past value
      ;;
    -k|--key)
      echo "Color Key (resources): Red - Very low or none, Yellow - Sorta low, Green - OK"
      echo "Color Key (node state): Red - Unreachable, Blue - Not accepting jobs normally"
      echo "Color Key (node state): White - Idle"
      exit 1
      ;;
    -h|--help|-?)
      usage
      exit 0
      ;;
    -*|--*)
      echo "Unknown option $1"
      usage
      exit 1
      ;;
    *)
      POSITIONAL_ARGS+=("$1") # save positional arg
      shift # past argument
      ;;
  esac
done

# Defining these vars was hoped to lead to consistent usage everywhere but
# the awk program has embedded printf code containing these var's contents.
HEADING_GPU="NODENAME     NODESTATE CPUS_A/T CPU_LOAD  TOT_MEM FREEMEM SYSFREEMEM  GPUS GPU_TYPES:COUNT     PARTITIONS"
HEADING_STANDARD="NODENAME     NODESTATE CPUS_A/T CPU_LOAD  TOT_MEM FREEMEM SYSFREEMEM PARTITIONS"

# Print appropriate starting column titles - gpu or  default
if [ ${GPUSTATS} -gt 0 ]
then
	echo "${HEADING_GPU}"
else
	echo "${HEADING_STANDARD}"
fi

#
# GET DATA FROM SINFO AND PROCESS IT WITH COMPLEX AWK PROGRAM
#

#   About the BEGIN code: JRT added BEGIN { OFMT = "%.0f" } to round all
#   non-integers to zero decimal places. To handle places where printf does not
#   handle them properly.

# Approach used before v1.0:
#sinfo -h $PARTITION -N -O  $SINFOOPTS | awk -v gpuvar="$GPUSTATS" 'BEGIN { OFMT = "%.0f" }; {

# Get the data
nodes=$(sinfo -h ${PARTITION} -N -O "${SINFOOPTS}")

# Process the data (using a "here string" (<<<) )
awk -v gpuvar="$GPUSTATS" '
   BEGIN { OFMT = "%.0f" }

   # main awk program section begins
   {

   # awk variables
   CLEAR="\033[0m";
   RED="\033[31m";
   GREEN="\033[32m";
   YELLOW="\033[33m";
   BLUE="\033[34m";
   MAGENTA="\033[35m";
   CYAN="\033[36m";
   WHITE="\033[37m";

   # To help keep track when creating printf args
   # DEFAULT MODE: Numbering of awk output fields 
   # $1 = Nodelist
   # $2 = StateComplete
   # $3 = Partition
   # $4 = CPUsState
   # $5 = CPUsLoad
   # $6 = Memory
   # $7 = AllocMem
   # $8 = FreeMEM

   # GPU MODE: Numbering of awk output fields
   # $9 = GPU Total  Format: gpu:tesv100:2,gpu:titanv:1
   # $10 = GPU Used  Format: gpu:tesv100:1(IDX:0),gpu:titanv:0(IDX:N/A)

   # PRINT EACH NODE, CHOOSING COLORS AS YOU GO, CHAR BY CHAR

   if (LASTNODENAME == $1) { printf(",%s", $3); next; }

   FREECORECOLOR=GREEN;
   split($4,CORES,"/");
   if (CORES[2] < 10 ) { FREECORECOLOR=YELLOW; }
   if (CORES[2] < 2  ) { FREECORECOLOR=RED; }
   if (CORES[1] == 0  ) { FREECORECOLOR=CLEAR; }

   FREERAMCOLOR=GREEN;
   if (($6-$7) < 51200) { FREERAMCOLOR=YELLOW; }
   if (($6-$7) < 9216)  { FREERAMCOLOR=RED; }

   FREERAM=$6-$7

   SYSFREERAMCOLOR=WHITE;
   ALLOC_MEM=$7
   USED_MEM=($6-$8) # TOT_MEM - SYSFREEMEM

   STATE=substr($2,1,9)
   STATECOLOR=CLEAR
   #    if ( $2~/idle/ ) {  STATECOLOR=GREEN; STATE="IDLE"; }
   if ( $2~/idle/ ) {  STATECOLOR=CLEAR; }
   if ( $2~/allocated/ ) {  STATECOLOR=GREEN; }
   if ( $2~/mixed/ ) {  STATECOLOR=GREEN; }
   if ( $2~/drain/ ) {  STATECOLOR=BLUE; STATE="DRAIN"; }
   if ( $2~/down/ ) {  STATECOLOR=RED; STATE="DOWN"; }
   if ( $2~/not_responding/ ) {  STATECOLOR=RED; STATE="DOWN"; }
   if ( $2~/reserved/ ) {  
        STATECOLOR=BLUE; STATE="RESERVED"; 
        if ( $2~/not_responding/ ) {  STATECOLOR=RED; }
        if ( $2~/down/ ) {  STATECOLOR=RED; }
   }
   # note that these totals only include the specified partition(s)
   # MM - 2024-01-17 - exclude node from Totals if node is not available
   if ( ! ( ( STATE == "DRAIN" ) || ( STATE == "DOWN" ) || ( STATE == "RESERVED" ) ) ) {
        USEDCORES+=CORES[1]
        TOTCORES+=CORES[4]
        TOTRAM+=$6
        USEDRAM+=$7
   }

   # Deal with GPU option
   if (gpuvar > 0)
   { 
       GPUUSED=0
       GPUTOT=0
       split($9,GPUTOTARRAY,",")
       split($10,GPUUSEDARRAY,",")
       for (GPU in GPUUSEDARRAY) {
           split(GPUUSEDARRAY[GPU],GPUSPLIT,":")
           GPUUSED+=GPUSPLIT[3]
       }
       for (GPU in GPUTOTARRAY) {
           split(GPUTOTARRAY[GPU],GPUSPLIT,":")
           GPUCOUNT=gensub(/(.+)\(.+$/,"\\1","g",GPUSPLIT[3])
           GPUTOT+=GPUCOUNT
       }
       GPUGRANDTOT+=GPUTOT
       GPUGRANDTOTUSED+=GPUUSED

       # MM - 2025-03-27 - Added GPU models to output by running scontrol command

       command = "scontrol show node " $1 " | grep Gres= | cut -d= -f2 | sed \"s/gpu:/ /g\" | tr -d \" \"";
       command | getline GPUTYPES; close(command); 
       printf "\n%-12s %s%9s %s%4s/%3s\033[0m %8.2f %5d GB %s%4d GB\033[0m %7d GB %s%2s/%2s %-20s%-s", $1, STATECOLOR, STATE, FREECORECOLOR, CORES[1], CORES[4], $5, $6/1024, FREERAMCOLOR, ($6-$7)/1024, $8/1024, CLEAR, GPUUSED, GPUTOT, GPUTYPES, $3;
   } # end of   if (gpuvar > 0)

   else

   {
       printf "\n%-12s %s%9s %s%4s/%3s\033[0m %8.2f %5d GB %s%4d GB\033[0m %7d GB %s%-s", $1, STATECOLOR, STATE, FREECORECOLOR, CORES[1], CORES[4], $5, $6/1024, FREERAMCOLOR, ($6-$7)/1024, $8/1024, CLEAR, $3;
   }

    LASTNODENAME=$1

} # end of awk MAIN program section

END {
   # PRINT THE APPROPRIATE CLOSING MATERIAL (COLUMN TITLES & STATS)

   # print column titles
   if (gpuvar > 0)
   {
       print "\nNODENAME     NODESTATE CPUS_A/T CPU_LOAD  TOT_MEM FREEMEM SYSFREEMEM  GPUS GPU_TYPES:COUNT     PARTITIONS"
   }
   else
   {
       print "\nNODENAME     NODESTATE CPUS_A/T CPU_LOAD  TOT_MEM FREEMEM SYSFREEMEM PARTITIONS"
   }
   # print summary stat block

   # always print this two line summary block
   printf "Total Cores: %6s |Alloc Cores: %6s |Idle Cores: %6s |Core Usage: %%%3d\nTotal RAM: %5d GB |Alloc RAM: %5d GB |Free RAM: %5d GB |RAM Usage:  %%%3d\n",TOTCORES,USEDCORES,TOTCORES-USEDCORES,100*USEDCORES/TOTCORES,TOTRAM/1024,USEDRAM/1024,TOTRAM/1024-USEDRAM/1024,100*USEDRAM/TOTRAM; 

   # Add gpu summary line (which makes 3 lines of summary stats)
   if (gpuvar > 0)
   {
       printf "Total GPUs:  %s  | Total GPUs Used:  %s\n", GPUGRANDTOT, GPUGRANDTOTUSED;
   }

}' <<< "$nodes"   
# end of END section is also end of whole program! JRT thought that there
# would be a } for the END and then a } for the whole program. Nope.

exit 0
